# ~/.config/ghostty/config.ghostty
# Reload: Cmd+Shift+,   Check for errors: ghostty +validate-config
# Comments must be on their own line, never after a value.

# --- Theme (official Catppuccin port) ---
theme = catppuccin-mocha.conf

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 18
adjust-cell-height = 10%

# --- Window ---
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = tabs

# --- Cursor & mouse ---
cursor-style = bar
mouse-hide-while-typing = true

# --- Keyboard ---
# Left Option works as Alt (for Alt shortcuts); right Option still types { } | ~ etc.
macos-option-as-alt = left

# --- Developer add-ons ---

# Quick terminal from any app with Cmd+` (needs Accessibility permission)
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-size = 40%
quick-terminal-animation-duration = 0.15

# Reopen windows, tabs and splits (and their folders) after restarting Ghostty
window-save-state = always

# Selecting text copies it to the clipboard
copy-on-select = clipboard

# macOS notification when a command that ran 10s+ finishes while you're in another app
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

# Shell integration extras: sudo keeps Ghostty's terminfo; ssh sets it up on servers
shell-integration-features = sudo,ssh-env,ssh-terminfo

# --- Glass look ---
# background-opacity = 0.92
# background-blur = macos-glass-regular

# --- Catppuccin-coloured Dock icon (experimental option) ---
# macos-icon = custom-style
# macos-icon-frame = plastic
# macos-icon-ghost-color = #cba6f7
# macos-icon-screen-color = #11111b,#1e1e2e
